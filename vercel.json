{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{chatgpt/server/static/**,chatgpt/STARTER-PROMPT.md,skills/berlin-job-search/scripts/search.py,skills/berlin-job-search/scripts/analyze_jd.py,skills/berlin-job-search/scripts/job_detail.py,skills/berlin-job-search/assets/companies.json}"
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api",
      "transforms": [{ "type": "request.path", "op": "set", "args": "/" }]
    },
    {
      "src": "^/mcp$",
      "dest": "/api",
      "transforms": [{ "type": "request.path", "op": "set", "args": "/mcp" }]
    },
    {
      "src": "^/privacy$",
      "dest": "/api",
      "transforms": [{ "type": "request.path", "op": "set", "args": "/privacy" }]
    },
    {
      "src": "^/terms$",
      "dest": "/api",
      "transforms": [{ "type": "request.path", "op": "set", "args": "/terms" }]
    },
    {
      "src": "^/healthz$",
      "dest": "/api",
      "transforms": [{ "type": "request.path", "op": "set", "args": "/healthz" }]
    }
  ]
}
